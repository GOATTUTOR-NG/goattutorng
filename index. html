            const next = LEVELS.find(l => l.level === level + 1);
            if (!next) return 100;
            const xpInLevel = xp - current.xpRequired;
            const xpNeeded = next.xpRequired - current.xpRequired;
            return Math.min((xpInLevel / xpNeeded) * 100, 100);
        }

