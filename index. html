        function removeScreeningSubject(btn) {
            const container = document.getElementById('screeningSubjects');
            if (container.children.length <= 2) { showNotification('⚠️ Keep at least two subjects.'); return; }
            btn.closest('.screening-subject-row').remove();
        }

        function calculateScreening() {
            const jamb = parseFloat(document.getElementById('screeningJamb').value);
            if (isNaN(jamb) || jamb < 0 || jamb > 400) {
                showNotification('⚠️ Enter a valid JAMB score (0-400).');
                return;
            }
            const subjects = document.querySelectorAll('.screening-subject');
            const grades = document.querySelectorAll('.screening-grade');
            let totalGradePoints = 0;
            grades.forEach(g => { totalGradePoints += GRADE_POINTS[g.value] || 0; });
            if (subjects.length < 2) { showNotification('⚠️ Add at least 2 subjects.'); return; }
            const jambScore = (jamb / 400) * 60;
            const olevelScore = (totalGradePoints / (subjects.length * 8)) * 40;
            const total = jambScore + olevelScore;
            const result = document.getElementById('screeningResult');
            result.style.display = 'block';
            result.innerHTML = `
                <div style="font-size:1.8rem;font-weight:700;color:#fbbf24;">${total.toFixed(2)}%</div>
                <div class="small">JAMB: ${jambScore.toFixed(1)}% + O'Level: ${olevelScore.toFixed(1)}%</div>
                <div class="small" style="margin-top:4px;">Based on ${subjects.length} subjects</div>
            `;
            awardXP(5, 'screening_calculated');
            showNotification('🎯 Screening score calculated!');
        }

