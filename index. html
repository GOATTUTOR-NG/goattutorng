        function logStudyDay() {
            const today = new Date().toDateString();
            const lastStudy = localStorage.getItem('lastStudyDay');
            const streak = parseInt(localStorage.getItem('streak')) || 0;
            const bestStreak = parseInt(localStorage.getItem('bestStreak')) || 0;
            const totalDays = parseInt(localStorage.getItem('totalStudyDays')) || 0;
            if (lastStudy === today) { showNotification('✅ Already logged today.'); return; }
            const yesterday = new Date();
            yesterday.setDate(yesterday.getDate() - 1);
            let newStreak = 1;
            if (lastStudy === yesterday.toDateString()) newStreak = streak + 1;
            localStorage.setItem('streak', newStreak);
            localStorage.setItem('lastStudyDay', today);
