        // ─── XP AWARD ───
        async function awardXP(amount, activity) {
            if (!currentUser) {
                let xp = parseInt(localStorage.getItem('xp')) || 0;
                xp += amount;
                localStorage.setItem('xp', xp);
                const level = getLevelFromXP(xp);
                localStorage.setItem('level', level);
                updateDash();
                updateGamificationUI();
                showNotification(`⚡ +${amount} XP (${activity})`, 2000);
                return;
            }
            try {
                const userRef = db.collection('users').doc(currentUser.uid);
                const doc = await userRef.get();
                if (!doc.exists) return;
                const data = doc.data();
                const newXP = (data.xp || 0) + amount;
                const newLevel = getLevelFromXP(newXP);
                await userRef.update({
                    xp: newXP,
                    level: newLevel,
                    updatedAt: firebase.firestore.FieldValue.serverTimestamp()
                });
                if (newLevel > (data.level || 1)) {
                    fireConfetti();
                    showNotification(`🎉 LEVEL UP! You're now a ${getLevelData(newLevel).name} ${getLevelData(newLevel).icon}`, 5000);
                }
                await checkBadges();
                localStorage.setItem('xp', newXP);
                localStorage.setItem('level', newLevel);
                updateDash();
                updateGamificationUI();
                showNotification(`⚡ +${amount} XP (${activity})`, 2000);
            } catch (err) { console.error('awardXP error:', err); }
        }

        // ─── BADGE CHECK ───
        async function checkBadges() {
            if (!currentUser) return;
            try {
                const userRef = db.collection('users').doc(currentUser.uid);
                const doc = await userRef.get();
                if (!doc.exists) return;
                const data = doc.data();
                const unlocked = data.badges || [];
                let newBadges = [];
                const streak = data.streak || 0;
                const xp = data.xp || 0;
                for (const badge of BADGE_DEFS) {
                    if (unlocked.includes(badge.id)) continue;
                    let condition = false;
                    switch (badge.id) {
                        case 'first_quiz': condition = (data.quizCount || 0) >= 1; break;
                        case 'streak_7': condition = streak >= 7; break;
                        case 'streak_30': condition = streak >= 30; break;
                        case 'read_notes': condition = (data.notesRead || 0) >= 50; break;
                        case 'quiz_master': condition = (data.quizCount || 0) >= 10; break;
                        case 'perfect_score': condition = (data.perfectQuizzes || 0) >= 1; break;
                        case 'top_10': condition = (data.top10Rank || false); break;
                        case 'xp_5000': condition = xp >= 5000; break;
                    }
                    if (condition) {
                        newBadges.push(badge.id);
                        fireConfetti();
                        showNotification(`🏅 Badge Unlocked: ${badge.icon} ${badge.name}`, 4000);
                    }
                }
                if (newBadges.length > 0) {
                    await userRef.update({
                        badges: firebase.firestore.FieldValue.arrayUnion(...newBadges),
                        updatedAt: firebase.firestore.FieldValue.serverTimestamp()
                    });
                    // FIX: mirror badges into localStorage so the UI updates
                    localStorage.setItem('badges', JSON.stringify([...unlocked, ...newBadges]));
                    for (const b of newBadges) await awardXP(50, 'badge_unlocked');
                }
                updateGamificationUI();
            } catch (err) { console.error('checkBadges error:', err); }
        }

