        function updateGpaPoints() {
            const rows = document.querySelectorAll('#gpaTableBody tr');
            let totalPoints = 0,
                totalUnits = 0;
            rows.forEach((row, i) => {
                const unitsEl = row.querySelector('.gpa-units');
                const gradeEl = row.querySelector('.gpa-grade-select');
                const pointEl = document.getElementById(`gpaPoint_${i}`);
                if (unitsEl && gradeEl && pointEl) {
                    const units = parseFloat(unitsEl.value) || 0;
                    const grade = gradeEl.value;
                    const points = (GRADE_MAP[grade] || 0) * units;
                    pointEl.textContent = (GRADE_MAP[grade] || 0).toFixed(1);
                    totalPoints += points;
                    totalUnits += units;
                }
            });
            const gpa = totalUnits > 0 ? (totalPoints / totalUnits) : 0;
            document.getElementById('gpaResultValue').textContent = gpa > 0 ? `${gpa.toFixed(2)} / 5.0` : '-- / 5.0';
            document.getElementById('gpaUnitsInfo').textContent = `(${totalUnits} units)`;
            window._currentGPA = gpa;
            window._currentUnits = totalUnits;
            window._gpaRows = rows;
