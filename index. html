            if (gpa === 0 || units === 0) {
                showNotification('⚠️ Calculate GPA first or add courses.');
                return;
            }
            const semesters = getSavedSemesters();
            const defaultLabel = `Semester ${semesters.length + 1}`;
            const label = prompt('Enter semester label:', defaultLabel);
            if (!label) return;
            const codes = document.querySelectorAll('.gpa-code');
            const unitsEls = document.querySelectorAll('.gpa-units');
            const gradesEls = document.querySelectorAll('.gpa-grade-select');
            const courses = [];
            codes.forEach((el, i) => {
                const code = el.value.trim() || `Course ${i+1}`;
                const u = parseFloat(unitsEls[i]?.value) || 0;
                const g = gradesEls[i]?.value || 'A';
                courses.push({ code, units: u, grade: g, points: GRADE_MAP[g] || 0 });
            });
            semesters.push({
                label,
                gpa: parseFloat(gpa.toFixed(2)),
                totalUnits: units,
                courses: courses,
                date: new Date().toISOString()
            });
            saveSemesters(semesters);
            localStorage.setItem('gpaSemesterTitle', label);
            document.getElementById('gpaSemesterTitle').textContent = label;
            showNotification('✅ Semester saved!');
