        // ─── QUIZ SYSTEM ───
        let currentQuestions = [];
        let currentIndex = 0;
        let quizScore = 0;
        let quizAnswered = false;

        function shuffleArray(arr) {
            for (let i = arr.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [arr[i], arr[j]] = [arr[j], arr[i]];
            }
            return arr;
        }

        function getQuestionsForCourse(courseFilter) {
            const filtered = courseFilter === 'all' ? QUESTION_BANK : QUESTION_BANK.filter(q => q.course === courseFilter);
            if (filtered.length === 0) {
                return shuffleArray([...QUESTION_BANK]).slice(0, 5);
            }
            return shuffleArray([...filtered]).slice(0, 5);
        }

        function startDailyQuiz() {
            const courseFilter = document.getElementById('quizCourseFilter').value;
            const container = document.getElementById('quizContainer');

            const today = new Date().toDateString();
            const key = 'quizAttempt_' + courseFilter + '_' + today;
            const quizAttempted = localStorage.getItem(key);

            if (quizAttempted) {
                const savedScore = parseInt(localStorage.getItem('quizScore_' + courseFilter)) || 0;
                container.innerHTML = `
                    <div class="quiz-complete">
                        <span class="big-icon">✅</span>
                        <div class="final-score">You scored ${savedScore}/5 today</div>
                        <div class="small">Come back tomorrow for a new set of questions.</div>
                        <button onclick="resetQuiz()" class="small-btn secondary" style="margin-top:10px;">🔄 Retake Quiz</button>
                    </div>
                `;
                return;
            }

            currentQuestions = getQuestionsForCourse(courseFilter);
            currentIndex = 0;
            quizScore = 0;
            quizAnswered = false;
            renderQuizQuestion();
        }

        function renderQuizQuestion() {
            const container = document.getElementById('quizContainer');
            if (currentIndex >= currentQuestions.length) {
                const total = currentQuestions.length;
                const savedScore = quizScore;
                const courseFilter = document.getElementById('quizCourseFilter').value;
                const today = new Date().toDateString();
                const key = 'quizAttempt_' + courseFilter + '_' + today;
                localStorage.setItem(key, 'done');
                localStorage.setItem('quizScore_' + courseFilter, savedScore);
                const xpEarned = savedScore * 5;
                if (xpEarned > 0) awardXP(xpEarned, 'daily_quiz');
                if (savedScore === total) fireConfetti();

                // FIX: record quiz completion in Firestore so badges can unlock
                if (currentUser) {
                    const updates = { quizCount: firebase.firestore.FieldValue.increment(1) };
                    if (savedScore === total) updates.perfectQuizzes = firebase.firestore.FieldValue.increment(1);
                    db.collection('users').doc(currentUser.uid).update(updates)
                        .then(() => checkBadges())
                        .catch(() => {});
                }

                container.innerHTML = `
                    <div class="quiz-complete">
                        <span class="big-icon">🏁</span>
                        <div class="final-score">You scored ${savedScore} / ${total}</div>
                        <div class="small">XP Earned: +${xpEarned}</div>
                        <button onclick="resetQuiz()" class="small-btn secondary" style="margin-top:10px;">🔄 Retake Quiz</button>
                    </div>
                `;
                return;
            }
            const q = currentQuestions[currentIndex];
            const options = q.options;
            const labels = ['A', 'B', 'C', 'D'];
            let optionsHtml = '';
            options.forEach((opt, idx) => {
                optionsHtml += `
                    <div class="quiz-option" data-index="${idx}" onclick="selectQuizOption(${idx})">
                        <span class="option-label">${labels[idx]}</span>
                        <span>${opt}</span>
                    </div>
                `;
            });
            container.innerHTML = `
                <div class="quiz-container">
                    <div class="quiz-progress">
                        <span class="q-number">Question ${currentIndex+1} of ${currentQuestions.length}</span>
                        <span class="score-display">Course: ${q.course}</span>
                    </div>
                    <div class="quiz-question">${q.question}</div>
                    <div class="quiz-options" id="quizOptions">${optionsHtml}</div>
                    <div class="quiz-feedback" id="quizFeedback"></div>
                    <div class="quiz-nav">
                        <button onclick="nextQuizQuestion()" id="nextBtn" disabled>Next →</button>
                    </div>
                </div>
            `;
            quizAnswered = false;
            document.getElementById('nextBtn').disabled = true;
        }

        function selectQuizOption(index) {
            if (quizAnswered) return;
            const q = currentQuestions[currentIndex];
            const options = document.querySelectorAll('.quiz-option');
            options.forEach((el, i) => {
                el.classList.add('disabled');
                if (i === q.correct) el.classList.add('correct');
                else if (i === index && index !== q.correct) el.classList.add('wrong');
                if (i === index) el.classList.add('selected');
            });
            const feedback = document.getElementById('quizFeedback');
            if (index === q.correct) {
                quizScore++;
                feedback.innerHTML = `<span class="correct-text">✅ Correct! +5 XP</span>`;
                feedback.style.borderLeftColor = '#22c55e';
            } else {
                feedback.innerHTML = `<span class="wrong-text">❌ Incorrect. Correct answer was ${['A','B','C','D'][q.correct]}</span>`;
                feedback.style.borderLeftColor = '#ef4444';
            }
            feedback.classList.add('show');
            quizAnswered = true;
            document.getElementById('nextBtn').disabled = false;
        }

        function nextQuizQuestion() {
            currentIndex++;
            renderQuizQuestion();
        }

        function resetQuiz() {
            const courseFilter = document.getElementById('quizCourseFilter').value;
            const today = new Date().toDateString();
            const key = 'quizAttempt_' + courseFilter + '_' + today;
            localStorage.removeItem(key);
            localStorage.removeItem('quizScore_' + courseFilter);
            startDailyQuiz();
        }

        // ─── TIMER ───
        function setTimerPreset() {
            const val = document.getElementById('timerPreset').value;
            const custom = document.getElementById('timerCustom');
            if (val === 'custom') custom.style.display = 'block';
            else {
                custom.style.display = 'none';
                timerSeconds = parseInt(val) * 60;
                timerRemaining = timerSeconds;
                updateTimerDisplay();
                if (timerInterval) { clearInterval(timerInterval); timerInterval = null; isTimerRunning = false; }
                document.getElementById('timerStartBtn').innerText = '▶ Start';
            }
        }

        function applyCustomTimer() {
            const custom = document.getElementById('timerCustom');
            const mins = parseInt(custom.value);
            if (isNaN(mins) || mins < 1) { showNotification('⚠️ Enter a valid number.'); return; }
            timerSeconds = mins * 60;
            timerRemaining = timerSeconds;
            updateTimerDisplay();
            if (timerInterval) { clearInterval(timerInterval); timerInterval = null; isTimerRunning = false; }
            document.getElementById('timerStartBtn').innerText = '▶ Start';
            document.getElementById('timerCustom').style.display = 'none';
            document.getElementById('timerPreset').value = 'custom';
            showNotification('⏱ Timer set to ' + mins + ' min');
        }

        function updateTimerDisplay() {
            const mins = Math.floor(timerRemaining / 60);
            const secs = timerRemaining % 60;
            document.getElementById('timerDisplay').innerText =
                `${String(mins).padStart(2,'0')}:${String(secs).padStart(2,'0')}`;
        }

        function startTimer() {
            if (isTimerRunning) return;
            if (timerRemaining <= 0) { timerRemaining = timerSeconds; updateTimerDisplay(); }
            isTimerRunning = true;
            document.getElementById('timerStartBtn').innerText = '▶ Running';
            timerInterval = setInterval(() => {
                timerRemaining--;
                updateTimerDisplay();
                if (timerRemaining <= 0) {
                    clearInterval(timerInterval);
                    timerInterval = null;
                    isTimerRunning = false;
                    document.getElementById('timerStartBtn').innerText = '▶ Start';
                    pomodoroCompleted++;
                    localStorage.setItem('pomodoroCount', pomodoroCompleted);
                    document.getElementById('pomodoroCount').innerText = pomodoroCompleted;
                    const mins = Math.floor(timerSeconds / 60);
                    let studyMinutes = parseInt(localStorage.getItem('studyMinutes')) || 0;
                    studyMinutes += mins;
                    localStorage.setItem('studyMinutes', studyMinutes);
                    const log = JSON.parse(localStorage.getItem('sessionLog') || '[]');
                    log.push({ duration: mins, date: new Date().toLocaleString(), type: 'Study Session' });
                    localStorage.setItem('sessionLog', JSON.stringify(log));
                    awardXP(10, 'pomodoro_complete');
                    showNotification('⏰ Timer complete! +10 XP');
                    fireConfetti();
                    updateDash();
                    updateGamificationUI();
                    if (currentUser) syncLocalToCloud();
                }
            }, 1000);
        }

        function pauseTimer() {
            if (timerInterval) {
                clearInterval(timerInterval);
                timerInterval = null;
                isTimerRunning = false;
                document.getElementById('timerStartBtn').innerText = '▶ Resume';
            }
        }

        function resetTimer() {
            if (timerInterval) { clearInterval(timerInterval); timerInterval = null; }
            isTimerRunning = false;
            timerRemaining = timerSeconds;
            updateTimerDisplay();
            document.getElementById('timerStartBtn').innerText = '▶ Start';
        }

        // ─── PLANNER ───
        function addPlannerTask() {
            const task = document.getElementById('plannerTask').value.trim();
            const day = document.getElementById('plannerDay').value;
            if (!task) { showNotification('⚠️ Enter a task.'); return; }
            const planner = JSON.parse(localStorage.getItem('planner') || '[]');
            planner.push({ task, day, done: false, id: Date.now() });
            localStorage.setItem('planner', JSON.stringify(planner));
            document.getElementById('plannerTask').value = '';
            renderPlanner();
            showNotification('✅ Task added!');
        }

        function renderPlanner() {
            const container = document.getElementById('plannerList');
            const planner = JSON.parse(localStorage.getItem('planner') || '[]');
            if (planner.length === 0) {
                container.innerHTML = '<span class="small">No tasks planned yet.</span>';
                return;
            }
            let html = '';
            const days = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];
            days.forEach(day => {
                const tasks = planner.filter(t => t.day === day);
                if (tasks.length === 0) return;
                html += `<div style="font-weight:600;color:#fbbf24;margin-top:4px;">${day}</div>`;
                tasks.forEach(t => {
                    html += `
                        <div class="history-item" style="display:flex;justify-content:space-between;align-items:center;padding:6px 10px;background:#0f172a;border-radius:6px;border:1px solid #334155;margin-top:2px;">
                            <span style="${t.done ? 'text-decoration:line-through;color:#94a3b8;' : ''}">${t.task}</span>
                            <div style="display:flex;gap:4px;">
                                <button onclick="togglePlannerTask(${t.id})" class="small-btn secondary" style="width:auto;min-height:28px;padding:2px 10px;font-size:0.7rem;">${t.done ? '↩️' : '✅'}</button>
                                <button onclick="removePlannerTask(${t.id})" class="small-btn danger" style="width:auto;min-height:28px;padding:2px 10px;font-size:0.7rem;">✕</button>
                            </div>
                        </div>
                    `;
                });
            });
            container.innerHTML = html;
        }

        function togglePlannerTask(id) {
            const planner = JSON.parse(localStorage.getItem('planner') || '[]');
            const task = planner.find(t => t.id === id);
            if (task) { task.done = !task.done; localStorage.setItem('planner', JSON.stringify(planner)); renderPlanner(); }
        }

        function removePlannerTask(id) {
            let planner = JSON.parse(localStorage.getItem('planner') || '[]');
            planner = planner.filter(t => t.id !== id);
            localStorage.setItem('planner', JSON.stringify(planner));
            renderPlanner();
        }

