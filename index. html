        function calculateTarget() {
            const semesters = getSavedSemesters();
            if (semesters.length === 0) {
                showNotification('⚠️ No semesters saved. Add your past semesters first.');
                return;
            }
            let totalPoints = 0,
                totalUnits = 0;
            semesters.forEach(s => {
                totalPoints += s.gpa * s.totalUnits;
                totalUnits += s.totalUnits;
            });

            const currentUnits = targetCourses.reduce((sum, c) => sum + c.units, 0);
            if (currentUnits === 0) {
                showNotification('⚠️ Add your current semester courses first.');
                return;
            }

            const targetCGPA = targetPreset;
            const targetTotalPoints = targetCGPA * (totalUnits + currentUnits);
            const requiredPoints = targetTotalPoints - totalPoints;
            const requiredGPA = requiredPoints / currentUnits;

            const resultDiv = document.getElementById('targetResult');
            resultDiv.style.display = 'block';

            document.getElementById('targetRequiredGPA').textContent = requiredGPA.toFixed(2) + ' / 5.0';

            const goalLabel = getDegreeClass(targetCGPA);
            document.getElementById('targetGoalLabel').textContent = goalLabel;

            const badge = document.getElementById('targetGoalBadge');
            badge.textContent = goalLabel;
            if (targetCGPA >= 4.5) badge.className = 'target-label first-class';
            else if (targetCGPA >= 3.5) badge.className = 'target-label second-upper';
            else if (targetCGPA >= 2.4) badge.className = 'target-label second-lower';
            else if (targetCGPA >= 1.5) badge.className = 'target-label third-class';
            else badge.className = 'target-label pass';

            let breakdownHtml =
                `<table><thead><tr><th>Course</th><th>Units</th><th>Required Grade</th><th>Points Needed</th></tr></thead><tbody>`;
            targetCourses.forEach(c => {
                const pointsNeededPerUnit = requiredGPA;
                const totalPointsNeeded = pointsNeededPerUnit * c.units;
                let gradeNeeded = '';
                let colorClass = '';
                if (pointsNeededPerUnit <= 3.0) { gradeNeeded = 'C (3.0)';
                    colorClass = 'need-ok'; } else if (pointsNeededPerUnit <= 4.0) { gradeNeeded = 'B (4.0)';
                    colorClass = 'need-tough'; } else if (pointsNeededPerUnit <= 5.0) { gradeNeeded = 'A (5.0)';
                    colorClass = 'need-tough'; } else { gradeNeeded = 'A* (5.0+)';
                    colorClass = 'need-hard'; }
                breakdownHtml += `
                        <tr>
                            <td><strong>${c.code}</strong></td>
                            <td>${c.units}</td>
                            <td class="${colorClass}">${gradeNeeded}</td>
                            <td>${totalPointsNeeded.toFixed(2)} pts</td>
                        </tr>
                    `;
            });
            breakdownHtml += '</tbody></table>';
            document.getElementById('targetGradeBreakdown').innerHTML = breakdownHtml;

            const insight = document.getElementById('targetInsight');
            if (requiredGPA <= 3.0) {
                insight.innerHTML =
                    '✅ This is very achievable! Focus on consistency and you\'ll hit your target. Keep up the good work!';
            } else if (requiredGPA <= 4.0) {
                insight.innerHTML =
                    '💪 This is challenging but possible. Aim for B grades or higher across all courses. Stay focused and use GoatTutor\'s study tools daily!';
            } else if (requiredGPA <= 4.5) {
                insight.innerHTML =
                    '🔥 You need a strong performance this semester. Aim for A grades in most courses. Use the AI tutor, daily quiz, and study timer to maximize your results.';
            } else if (requiredGPA <= 5.0) {
                insight.innerHTML =
                    '⭐ You need a near-perfect semester! This is tough but not impossible. Consider reducing your course load or seeking extra help from your lecturers.';
            } else {
                insight.innerHTML =
                    '⚠️ The required GPA is above 5.0 — unfortunately, it\'s mathematically impossible to reach your target this semester. Consider adjusting your target or adding more courses.';
            }

            showNotification(`🎯 Target CGPA calculation complete!`, 3000);
            awardXP(10, 'target_cgpa_calc');
        }

