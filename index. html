        document.addEventListener('DOMContentLoaded', function() {
            const dropArea = document.getElementById('pdfDropArea');
            ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
                dropArea.addEventListener(eventName, preventDefaults, false);
            });

            function preventDefaults(e) {
                e.preventDefault();
                e.stopPropagation();
            }
            dropArea.addEventListener('dragover', function() {
                this.classList.add('dragover');
            });
            dropArea.addEventListener('dragleave', function() {
                this.classList.remove('dragover');
            });
            dropArea.addEventListener('drop', function(e) {
                this.classList.remove('dragover');
                const files = e.dataTransfer.files;
                if (files.length > 0 && files[0].type === 'application/pdf') {
                    document.getElementById('pdfFileInput').files = files;
                    handlePDFFile({ target: { files: files } });
                } else {
                    showNotification('⚠️ Please drop a PDF file.');
                }
            });
        });

        function handlePDFFile(event) {
            const file = event.target.files[0];
            if (!file) return;
            if (file.type !== 'application/pdf') {
                document.getElementById('pdfExtractStatus').innerHTML = '❌ Please select a PDF file.';
                document.getElementById('pdfExtractStatus').className = 'pdf-extract-status error';
                return;
            }
            const statusEl = document.getElementById('pdfExtractStatus');
            statusEl.innerHTML = '⏳ Extracting text from PDF… (this may take a moment)';
            statusEl.className = 'pdf-extract-status';

            const reader = new FileReader();
            reader.onload = function(e) {
                const typedarray = new Uint8Array(e.target.result);
                pdfjsLib.getDocument(typedarray).promise.then(function(pdf) {
                    let fullText = '';
                    let pages = pdf.numPages;
                    let pagePromises = [];
                    for (let i = 1; i <= pages; i++) {
                        pagePromises.push(pdf.getPage(i).then(function(page) {
                            return page.getTextContent().then(function(textContent) {
                                let pageText = '';
                                textContent.items.forEach(function(item) {
                                    pageText += item.str + ' ';
                                });
                                return pageText;
                            });
                        }));
                    }
                    Promise.all(pagePromises).then(function(pageTexts) {
                        fullText = pageTexts.join('\n');
                        extractedPDFText = fullText.trim();
                        pdfExtractedPages = pages;
                        const preview = extractedPDFText.slice(0, 500) + (extractedPDFText.length > 500 ? '...' : '');
                        document.getElementById('pdfTextPreview').innerText = preview;
                        document.getElementById('pdfTextContainer').style.display = 'block';
                        statusEl.innerHTML = `✅ Extracted <strong>${extractedPDFText.length}</strong> characters from <strong>${pages}</strong> page(s).`;
                        statusEl.className = 'pdf-extract-status success';
                        showNotification('📄 PDF extracted successfully!');
                        awardXP(5, 'pdf_upload');
                        document.getElementById('pdfAiReply').innerHTML = '💬 Ask a question about the PDF above.';
                    }).catch(function(err) {
                        console.error(err);
                        statusEl.innerHTML = '❌ Failed to extract text. The PDF may be image-based or corrupted.';
                        statusEl.className = 'pdf-extract-status error';
                        showNotification('⚠️ PDF extraction failed. Try a different PDF.');
                    });
                }).catch(function(err) {
                    console.error(err);
                    statusEl.innerHTML = '❌ Failed to parse PDF. The file may be invalid or password-protected.';
                    statusEl.className = 'pdf-extract-status error';
                    showNotification('⚠️ Could not parse PDF.');
                });
            };
            reader.readAsArrayBuffer(file);
        }

