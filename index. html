        // ─── UPDATES ───
        async function loadUpdates() {
            const container = document.getElementById('updatesContainer');
            try {
                const snap = await db.collection('updates').limit(10).get();
                if (snap.empty) { container.innerHTML = '<span class="small">No updates yet.</span>'; return; }
                const docs = snap.docs.sort((a, b) => {
                    const da = a.data().createdAt?.toMillis() || 0;
                    const db2 = b.data().createdAt?.toMillis() || 0;
                    return db2 - da;
                });
                let html = '';
                docs.forEach(doc => {
                    const data = doc.data();
                    const date = data.createdAt ? new Date(data.createdAt.toDate()).toLocaleDateString() : 'Today';
                    const tag = data.category || 'general';
                    const tagLabel = tag === 'education' ? '📚 Education' : tag === 'uniosun' ? '🎓 UNIOSUN' : '📌 General';
                    html += `
                        <div class="update-item">
                            <div class="date">${date}</div>
                            <div class="content"><strong>${data.title || 'Update'}</strong><br>${data.content || ''}</div>
                            <span class="tag">${tagLabel}</span>
                        </div>
                    `;
                });
                container.innerHTML = html;
            } catch (err) {
                console.error('Load updates error:', err);
                container.innerHTML = '<span class="small">Error loading updates.</span>';
            }
        }

        async function submitUpdate() {
            const statusEl = document.getElementById('updateStatus');
            statusEl.innerText = '⏳ Publishing...';
            if (!currentUser) { statusEl.innerText = '⛔ Please log in.'; return; }
            if (currentUser.uid !== ADMIN_UID) { statusEl.innerText = '⛔ Not authorized.'; return; }
            const title = document.getElementById('updateTitle').value.trim();
            const content = document.getElementById('updateContent').value.trim();
            const category = document.getElementById('updateCategory').value;
            if (!title || !content) { statusEl.innerText = '⚠️ Fill in both fields.'; return; }
            try {
                await db.collection('updates').add({ title, content, category, createdAt: firebase.firestore.FieldValue.serverTimestamp() });
                document.getElementById('updateTitle').value = '';
                document.getElementById('updateContent').value = '';
                statusEl.innerText = '✅ Update published!';
                showNotification('✅ Update published!');
                await loadUpdates();
            } catch (err) {
                console.error('Submit update error:', err);
                statusEl.innerText = '❌ Failed: ' + err.message;
            }
        }

        // ─── STREAK ───
        function logStudyDay() {
            const today = new Date().toDateString();
            const lastStudy = localStorage.getItem('lastStudyDay');
            const streak = parseInt(localStorage.getItem('streak')) || 0;
            const bestStreak = parseInt(localStorage.getItem('bestStreak')) || 0;
            const totalDays = parseInt(localStorage.getItem('totalStudyDays')) || 0;
            if (lastStudy === today) { showNotification('✅ Already logged today.'); return; }
            const yesterday = new Date();
            yesterday.setDate(yesterday.getDate() - 1);
            let newStreak = 1;
            if (lastStudy === yesterday.toDateString()) newStreak = streak + 1;
            localStorage.setItem('streak', newStreak);
            localStorage.setItem('lastStudyDay', today);
            localStorage.setItem('totalStudyDays', totalDays + 1);
            if (newStreak > bestStreak) {
                localStorage.setItem('bestStreak', newStreak);
                showNotification('🎉 New best streak: ' + newStreak + ' days!');
                fireConfetti();
            } else { showNotification('🔥 Streak: ' + newStreak + ' days!'); }
            awardXP(5, 'daily_login');
            updateDash();
            updateGamificationUI();
            if (currentUser) syncLocalToCloud();
        }

        function resetStreakStats() {
            if (!confirm('Reset all streak stats?')) return;
            localStorage.removeItem('streak');
            localStorage.removeItem('bestStreak');
            localStorage.removeItem('totalStudyDays');
            localStorage.removeItem('lastStudyDay');
            updateStreakUI();
            document.getElementById('streakDisplay').innerText = '0';
            showNotification('🔄 Streak reset.');
            if (currentUser) syncLocalToCloud();
