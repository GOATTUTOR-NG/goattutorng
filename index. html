            if (!code) { showNotification('⚠️ Enter a course code.'); return; }
            if (isNaN(units) || units <= 0) { showNotification('⚠️ Enter valid units.'); return; }
            targetCourses.push({ code, units });
            localStorage.setItem('targetCourses', JSON.stringify(targetCourses));
            codeInput.value = '';
            unitsInput.value = '';
