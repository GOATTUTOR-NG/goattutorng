        // ─── CALENDAR ───
        function renderCalendar() {
            const container = document.getElementById('calendarEvents');
            const events = getOfficialCalendarEvents();
            if (events.length === 0) {
                container.innerHTML = '<span class="small">No upcoming events.</span>';
                return;
            }
            let html = '';
            const now = new Date();
            events.forEach(e => {
                const d = new Date(e.date);
                const diff = d - now;
                let countdown = '';
                if (diff > 0) {
                    const days = Math.floor(diff / (1000 * 60 * 60 * 24));
                    const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                    countdown = `⏳ ${days}d ${hours}h`;
                } else if (diff > -86400000) {
                    countdown = '🟢 Today!';
                } else {
                    countdown = '✅ Passed';
                }
                const dateStr = d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
                let typeClass = '';
                if (e.type === 'harmattan' || e.type === 'rain') typeClass = e.type;
                else if (e.type === 'exam') typeClass = 'exam';
                else if (e.type === 'break') typeClass = 'break';
                else if (e.type === 'orientation') typeClass = 'orientation';
                else if (e.type === 'matriculation') typeClass = 'matriculation';
                else typeClass = 'harmattan';
                html += `
                    <div class="calendar-event ${typeClass}">
                        <span class="date">${dateStr}</span>
                        <span class="desc">${e.desc}</span>
                        <span class="countdown">${countdown}</span>
                    </div>
                `;
            });
            container.innerHTML = html;
        }

