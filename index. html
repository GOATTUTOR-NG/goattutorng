        // ─── DICTIONARY STATE ───
        let currentDictTab = 'medical';
        let dictSearchTerm = '';

        function switchDictTab(tab) {
            currentDictTab = tab;
            document.querySelectorAll('.dict-tabs button').forEach(btn => {
                btn.classList.remove('active-tab');
            });
            const tabBtn = document.getElementById('dictTab' + tab.charAt(0).toUpperCase() + tab.slice(1));
            if (tabBtn) tabBtn.classList.add('active-tab');
            renderDictionary();
        }

        function filterDictionary() {
            const input = document.getElementById('dictSearchInput');
            dictSearchTerm = input.value.trim().toLowerCase();
            renderDictionary();
        }

        function renderDictionary() {
            const container = document.getElementById('dictResults');
            const countEl = document.getElementById('dictCount');
            const terms = DICTIONARY_DATA[currentDictTab] || [];

            let filtered = terms;
            if (dictSearchTerm) {
                filtered = terms.filter(item =>
                    item.term.toLowerCase().includes(dictSearchTerm) ||
                    item.definition.toLowerCase().includes(dictSearchTerm) ||
                    (item.category && item.category.toLowerCase().includes(dictSearchTerm)) ||
                    (item.related && item.related.toLowerCase().includes(dictSearchTerm))
                );
            }

            if (filtered.length === 0) {
                container.innerHTML =
                    `<div class="dict-empty">🔍 No terms found for "<strong>${dictSearchTerm || '...'}</strong>". Try a different search.</div>`;
                countEl.textContent = `0 terms`;
                return;
            }

            let html = '';
            filtered.forEach(item => {
                const termColor = currentDictTab === 'medical' ? '#22c55e' : '#3b82f6';
                html += `
                    <div class="dict-term">
                        <div class="term" style="color:${termColor};">${item.term}</div>
                        <div class="definition">${item.definition}</div>
                        <span class="category-tag">📌 ${item.category || 'General'}</span>
                        ${item.related ? `<div class="related">🔗 ${item.related}</div>` : ''}
                    </div>
                `;
            });

            container.innerHTML = html;
            const label = currentDictTab.charAt(0).toUpperCase() + currentDictTab.slice(1);
            countEl.textContent = `Showing ${filtered.length} of ${terms.length} ${label} terms`;
        }

        // ─── FLASHCARD SYSTEM (KEYLESS, CLIENT-SIDE) ───

        // Smart flashcard generator – uses dictionary + templates, no API
        function generateFlashcardsFromConcept(concept, count) {
            const cards = [];
            const lowerConcept = concept.toLowerCase();

            // 1. Try to find a definition in our dictionary (medical or engineering)
            let foundDefinition = null;
            let foundCategory = '';
            const allTerms = [...DICTIONARY_DATA.medical, ...DICTIONARY_DATA.engineering];
            const match = allTerms.find(t => t.term.toLowerCase() === lowerConcept || t.term.toLowerCase().includes(
            lowerConcept));
            if (match) {
                foundDefinition = match.definition;
                foundCategory = match.category || '';
            }

            // 2. Build question-answer pairs
            if (foundDefinition) {
                // Use the dictionary definition as the answer
                cards.push({
                    question: `What is ${concept}?`,
                    answer: foundDefinition
                });
                // Add a second card: "Explain [concept] in detail"
                cards.push({
                    question: `Explain ${concept} in detail.`,
                    answer: foundDefinition + (foundCategory ? ` (Category: ${foundCategory})` : '')
                });
                // Add a third card: "What is the significance of [concept]?"
                cards.push({
                    question: `What is the significance of ${concept}?`,
                    answer: `${concept} is a key concept in ${foundCategory || 'this field'}. ${foundDefinition}`
                });
            } else {
                // No dictionary match – use intelligent templates
                const templates = [
                    { q: `What is ${concept}?`, a: `${concept} is a fundamental concept in its field.` },
                    { q: `Explain ${concept} in simple terms.`, a: `${concept} refers to the core idea behind this topic.` },
                    { q: `Why is ${concept} important?`, a: `${concept} plays a crucial role in understanding related concepts.` },
                    { q: `Give an example of ${concept}.`, a: `An example of ${concept} can be seen in real-world applications.` },
                    { q: `What are the key features of ${concept}?`,
                    a: `Key features of ${concept} include its defining characteristics.` },
                    { q: `How does ${concept} relate to everyday life?`,
                    a: `${concept} is relevant because it helps us understand our world.` },
                    { q: `What is the history of ${concept}?`, a: `${concept} has evolved over time through study and practice.` },
                    { q: `What are common misconceptions about ${concept}?`,
                    a: `A common misconception is that ${concept} is only relevant in academic contexts.` },
                    { q: `What is the future of ${concept}?`, a: `${concept} continues to develop with new research.` },
                    { q: `Summarize ${concept} in one sentence.`, a: `${concept} is a key idea that shapes our understanding.` },
                ];
                // Use the first 'count' templates (or all if count > templates.length)
                const selected = templates.slice(0, Math.min(count, templates.length));
                selected.forEach(t => cards.push({ question: t.q, answer: t.a }));
            }

            // Ensure we have exactly 'count' cards (pad if needed)
            while (cards.length < count) {
                const idx = cards.length % 10;
                const t = templates[idx] || templates[0];
                cards.push({
                    question: t.q.replace(/\?/, `? (${idx+1})`),
                    answer: t.a
                });
            }

            // Trim to exactly 'count'
            return cards.slice(0, count);
        }

        // ─── FLASHCARD STATE ───
        let currentDeck = [];
        let currentCardIndex = 0;
        let currentDeckName = '';

        function generateFlashcards() {
            const conceptInput = document.getElementById('flashcardConcept');
            const countSelect = document.getElementById('flashcardCount');
            const concept = conceptInput.value.trim();
            const count = parseInt(countSelect.value) || 5;

            if (!concept) {
                showNotification('⚠️ Please enter a concept.');
                return;
            }

            // Generate cards
            const cards = generateFlashcardsFromConcept(concept, count);

            if (cards.length === 0) {
                showNotification('⚠️ Could not generate flashcards. Try a different concept.');
                return;
            }

            // Save deck with a name
            const deckName = `${concept} (${new Date().toLocaleDateString()})`;
            currentDeckName = deckName;
            currentDeck = cards;
            currentCardIndex = 0;

            // Save to localStorage
            const decks = JSON.parse(localStorage.getItem('flashcardDecks') || '[]');
            decks.push({
                name: deckName,
                concept: concept,
                cards: cards,
                createdAt: new Date().toISOString()
            });
            localStorage.setItem('flashcardDecks', JSON.stringify(decks));

            // Render the deck
            renderActiveDeck();
            loadSavedDecks();
            showNotification(`✅ Generated ${cards.length} flashcards for "${concept}"! +5 XP`);
            awardXP(5, 'flashcards_generated');

            // Clear input
            conceptInput.value = '';
        }

        function renderActiveDeck() {
            const container = document.getElementById('flashcardDeckContainer');

            if (!currentDeck || currentDeck.length === 0) {
                container.innerHTML = `
                    <div class="flashcard-empty">
                        <span class="big-icon">🃏</span>
                        <p>Enter a concept above and click <strong>Generate</strong> to create your flashcards.</p>
                        <p class="small">Or load a previously saved deck below.</p>
                    </div>
                `;
                return;
            }

            const card = currentDeck[currentCardIndex];
            const total = currentDeck.length;
            const index = currentCardIndex + 1;

            let html = `
                <div class="flashcard-deck-title">📚 ${currentDeckName} (${total} cards)</div>
                <div class="flashcard" id="activeFlashcard" onclick="flipActiveCard()">
                    <div class="flashcard-inner">
                        <div class="flashcard-face flashcard-front">
                            <span class="card-label">❓ Question</span>
                            <div class="card-content">${escapeHtml(card.question)}</div>
                            <span class="card-hint">💡 Tap to flip</span>
                        </div>
                        <div class="flashcard-face flashcard-back">
                            <span class="card-label answer-label">✅ Answer</span>
                            <div class="card-content">${escapeHtml(card.answer)}</div>
                            <span class="card-hint">💡 Tap to flip back</span>
                        </div>
                    </div>
                </div>
                <div class="flashcard-counter">${index} / ${total}</div>
                <div class="flashcard-controls">
                    <button onclick="prevCard()" ${currentCardIndex === 0 ? 'disabled style="opacity:0.4;"' : ''}>◀ Prev</button>
                    <button onclick="nextCard()" ${currentCardIndex === total - 1 ? 'disabled style="opacity:0.4;"' : ''}>Next ▶</button>
                    <button onclick="editCurrentCard()" class="secondary small-btn" style="flex:0.5;min-width:60px;">✏️ Edit</button>
                    <button onclick="deleteCurrentDeck()" class="danger small-btn" style="flex:0.5;min-width:60px;">🗑 Delete</button>
                </div>
            `;

            container.innerHTML = html;
        }

        function flipActiveCard() {
            const card = document.getElementById('activeFlashcard');
            if (card) card.classList.toggle('flipped');
        }

        function nextCard() {
            if (currentCardIndex < currentDeck.length - 1) {
                currentCardIndex++;
                renderActiveDeck();
                // Reset flip state
                setTimeout(() => {
                    const card = document.getElementById('activeFlashcard');
                    if (card) card.classList.remove('flipped');
                }, 50);
            }
        }

        function prevCard() {
            if (currentCardIndex > 0) {
                currentCardIndex--;
                renderActiveDeck();
                setTimeout(() => {
                    const card = document.getElementById('activeFlashcard');
                    if (card) card.classList.remove('flipped');
                }, 50);
            }
        }

        function editCurrentCard() {
            if (!currentDeck || currentDeck.length === 0) return;
            const card = currentDeck[currentCardIndex];
            const modal = document.createElement('div');
            modal.className = 'flashcard-edit-modal';
            modal.id = 'editModal';
            modal.innerHTML = `
                <div class="modal-box">
                    <h4>✏️ Edit Card ${currentCardIndex + 1}</h4>
                    <label class="small">Question</label>
                    <textarea id="editQuestion">${escapeHtml(card.question)}</textarea>
                    <label class="small" style="margin-top:6px;display:block;">Answer</label>
                    <textarea id="editAnswer">${escapeHtml(card.answer)}</textarea>
                    <div class="modal-actions">
                        <button onclick="saveCardEdit()" style="background:#22c55e;">💾 Save</button>
                        <button onclick="closeEditModal()" class="secondary">Cancel</button>
                    </div>
                </div>
            `;
            document.body.appendChild(modal);
        }

        function saveCardEdit() {
            const q = document.getElementById('editQuestion').value.trim();
            const a = document.getElementById('editAnswer').value.trim();
            if (!q || !a) {
                showNotification('⚠️ Both fields are required.');
                return;
            }
            if (currentDeck && currentDeck.length > 0) {
                currentDeck[currentCardIndex].question = q;
                currentDeck[currentCardIndex].answer = a;
                // Update in localStorage
                updateDeckInStorage();
                closeEditModal();
                renderActiveDeck();
                showNotification('✅ Card updated!');
                awardXP(2, 'card_edited');
            }
        }

        function closeEditModal() {
            const modal = document.getElementById('editModal');
            if (modal) modal.remove();
        }

        function updateDeckInStorage() {
            const decks = JSON.parse(localStorage.getItem('flashcardDecks') || '[]');
            const deckIndex = decks.findIndex(d => d.name === currentDeckName);
            if (deckIndex !== -1) {
                decks[deckIndex].cards = currentDeck;
                localStorage.setItem('flashcardDecks', JSON.stringify(decks));
            }
        }

        function deleteCurrentDeck() {
            if (!currentDeck || currentDeck.length === 0) return;
            if (!confirm(`Delete deck "${currentDeckName}"?`)) return;
            const decks = JSON.parse(localStorage.getItem('flashcardDecks') || '[]');
            const filtered = decks.filter(d => d.name !== currentDeckName);
            localStorage.setItem('flashcardDecks', JSON.stringify(filtered));
            currentDeck = [];
            currentDeckName = '';
            currentCardIndex = 0;
            renderActiveDeck();
            loadSavedDecks();
            showNotification('🗑 Deck deleted.');
        }

        function loadSavedDecks() {
            const container = document.getElementById('savedDecksContainer');
            const decks = JSON.parse(localStorage.getItem('flashcardDecks') || '[]');

            if (decks.length === 0) {
                container.innerHTML = `<div class="small" style="text-align:center;padding:8px;">No saved decks yet. Generate your first deck above!</div>`;
                return;
            }

            let html = `<div style="font-weight:600;font-size:0.9rem;margin-bottom:4px;">📂 Saved Decks (${decks.length})</div><div class="saved-decks-grid">`;
            decks.forEach((deck, idx) => {
                const count = deck.cards ? deck.cards.length : 0;
                const date = deck.createdAt ? new Date(deck.createdAt).toLocaleDateString() : '';
                html += `
                    <div class="saved-deck-item" onclick="loadDeck(${idx})">
                        <div>
                            <div class="deck-name">${escapeHtml(deck.name)}</div>
                            <div class="deck-count">${count} cards ${date ? '· '+date : ''}</div>
                        </div>
                        <div class="deck-actions">
                            <button onclick="event.stopPropagation();loadDeck(${idx})" class="small-btn secondary" style="padding:2px 10px;font-size:0.7rem;">📖</button>
                            <button onclick="event.stopPropagation();deleteDeck(${idx})" class="small-btn danger" style="padding:2px 10px;font-size:0.7rem;">✕</button>
                        </div>
                    </div>
                `;
            });
            html += '</div>';
            container.innerHTML = html;
        }

        function loadDeck(index) {
            const decks = JSON.parse(localStorage.getItem('flashcardDecks') || '[]');
            if (index >= 0 && index < decks.length) {
                const deck = decks[index];
                currentDeckName = deck.name;
                currentDeck = deck.cards || [];
                currentCardIndex = 0;
                renderActiveDeck();
                showNotification(`📖 Loaded "${deck.name}"`);
            }
        }

        function deleteDeck(index) {
            const decks = JSON.parse(localStorage.getItem('flashcardDecks') || '[]');
            if (index >= 0 && index < decks.length) {
                if (!confirm(`Delete deck "${decks[index].name}"?`)) return;
                decks.splice(index, 1);
                localStorage.setItem('flashcardDecks', JSON.stringify(decks));
                if (currentDeckName === decks[index]?.name) {
                    currentDeck = [];
                    currentDeckName = '';
                    currentCardIndex = 0;
                    renderActiveDeck();
                }
                loadSavedDecks();
                showNotification('🗑 Deck deleted.');
            }
        }

        function clearAllDecks() {
            if (!confirm('Delete ALL saved decks? This cannot be undone.')) return;
            localStorage.setItem('flashcardDecks', '[]');
            currentDeck = [];
            currentDeckName = '';
            currentCardIndex = 0;
            renderActiveDeck();
            loadSavedDecks();
            showNotification('🗑 All decks cleared.');
        }

