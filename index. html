        function openPhysiologyTopic(id) {
            const t = physiologyTopics.find(x => x.id === id); if (!t) return;
            document.getElementById('physiologyLessonCard').innerHTML = `<h3>${t.icon} ${t.name}</h3><div class="lesson-box"><div class="case-step">UNDERSTAND → CONNECT → RECALL</div><p>${t.lesson}</p><div class="why"><strong>Clinical connection:</strong> ${t.why}</div><div class="memory">${t.memory}</div>${t.cbt?`<div style="margin-top:12px"><strong>${t.cbt[0]}</strong>${t.cbt.slice(1).map((x,i)=>`<button class="clinical-choice" onclick="checkMiniCBT(this,${i},${t.ans},'${t.id}')">${x}</button>`).join('')}</div>`:''}<button class="success" onclick="completeMedicalTopic('physiology','${t.id}')">✅ Mark topic learned</button></div>`;
        }
        function renderNursingTopics() { const g = document.getElementById('nursingTopicGrid'); if (g) g.innerHTML = nursingTopics.map(t => medTopicCard(t, 'openNursingTopic')).join(''); }
        function openNursingTopic(id) {
            const t = nursingTopics.find(x => x.id === id); if (!t) return;
            document.getElementById('nursingLessonCard').innerHTML = `<h3>${t.icon} ${t.name}</h3><div class="lesson-box"><div class="case-step">STUDENT NURSE MODE</div><p>${t.lesson}</p><div class="why"><strong>Why:</strong> ${t.why}</div><div class="memory">${t.memory}</div>${t.cbt?`<div style="margin-top:12px"><strong>${t.cbt[0]}</strong>${t.cbt.slice(1).map((x,i)=>`<button class="clinical-choice" onclick="checkMiniCBT(this,${i},${t.ans},'${t.id}')">${x}</button>`).join('')}</div>`:''}<button class="success" onclick="completeMedicalTopic('nursing','${t.id}')">✅ Mark topic learned</button></div>`;
        }
        function completeMedicalTopic(kind, id) { medTopicDone(kind + '_' + id); renderAnatomyTopics(); renderPhysiologyTopics(); renderNursingTopics(); showNotification('✅ Topic added to Medical Academy progress!'); }
        function checkMiniCBT(btn, index, ans, id) {
            const parent = btn.parentElement;
            parent.querySelectorAll('.clinical-choice').forEach(b => b.disabled = true);
            if (index === ans) { btn.classList.add('correct'); awardXP(3, 'medical_cbt'); showNotification('🎯 Correct!'); }
            else { btn.classList.add('wrong'); showNotification('📚 Not quite — review the explanation.'); }
        }
        const clinicalCases = [
          { title: 'Case 1 — Deteriorating patient', text: 'A patient is very drowsy and difficult to keep awake. T 37.1°C, pulse 58 bpm, RR 10/min, BP 94/60 mmHg, SpO₂ 91%.', q: 'What should you prioritise first?', opts: ['Airway and breathing assessment, then escalate urgently', 'Ask about lunch', 'Calculate BMI', 'Wait for the next routine observation'], ans: 0, ex: 'The altered consciousness plus slow breathing and low SpO₂ make airway/breathing an immediate concern. Use ABC and get appropriate help; act within your student scope and local protocol.' },
          { title: 'Case 2 — Insulin + classic symptoms', text: 'A patient who received insulin later becomes sweaty, shaky, very hungry and confused. Pulse is 110 bpm, BP 126/78, RR 20/min, SpO₂ 98%.', q: 'What is the best next check?', opts: ['Capillary blood glucose', 'Height', 'Temperature only', 'Ignore it because SpO₂ is normal'], ans: 0, ex: 'These symptoms strongly suggest possible hypoglycaemia. Check capillary glucose promptly and assess consciousness/swallowing; follow the facility protocol and seek appropriate help.' },
          { title: 'Case 3 — ABC reasoning', text: 'A patient is restless and confused. T 38.9°C, pulse 124 bpm, RR 30/min, BP 88/54 mmHg, SpO₂ 94%.', q: 'Which interpretation is safest?', opts: ['RR is high and circulation is concerning; use ABC and escalate', 'RR is low, so only breathing matters', 'Everything is normal because SpO₂ is above 90%', 'Diagnose the exact infection immediately'], ans: 0, ex: 'RR 30 is high, pulse 124 is fast and BP 88/54 is low. Confusion/restlessness adds concern. Do not jump to a diagnosis; prioritise ABC, escalate and monitor.' },
          { title: 'Case 4 — Fever pattern', text: 'T 38.7°C, pulse 112 bpm, RR 22/min, BP 110/70 mmHg, SpO₂ 96%. The patient is cold and shaking.', q: 'Which statement is best?', opts: ['Temperature is high; pulse and RR are also elevated', 'Only BP is abnormal', 'SpO₂ proves there is no illness', 'The patient definitely has one specific infection'], ans: 0, ex: 'Fever is present, pulse is elevated and RR is slightly above a common adult resting teaching range. Assess the patient and look for the cause rather than assuming a diagnosis.' }
        ];
        let clinicalIndex = Number(localStorage.getItem('medClinicalIndex') || 0);
        function renderClinicalCase() {
            const c = clinicalCases[clinicalIndex % clinicalCases.length], el = document.getElementById('clinicalCaseCard');
            if (!el) return;
            el.innerHTML = `<h3>🚨 ${c.title}</h3><div class="lesson-box"><div class="case-step">LOOK → RECOGNIZE → PRIORITIZE → ACT</div><p>${c.text}</p><div style="margin-top:10px"><strong>${c.q}</strong>${c.opts.map((o,i)=>`<button class="clinical-choice" onclick="answerClinicalCase(this,${i},${c.ans})">${String.fromCharCode(65+i)}. ${o}</button>`).join('')}</div><div id="clinicalFeedback"></div></div>`;
        }
        function answerClinicalCase(btn, i, ans) {
            const c = clinicalCases[clinicalIndex % clinicalCases.length];
            const all = btn.parentElement.querySelectorAll('.clinical-choice');
            all.forEach(b => b.disabled = true);
            if (i === ans) {
                btn.classList.add('correct');
                medicalData.cases = (medicalData.cases || 0) + 1; saveMedical(); awardXP(8, 'clinical_case');
                document.getElementById('clinicalFeedback').innerHTML = `<div class="case-feedback">🎯 <strong>Good clinical thinking.</strong><br>${c.ex}<br><button onclick="nextClinicalCase()">➡️ Next case</button></div>`;
            } else {
                btn.classList.add('wrong');
                medicalData.mistakes.push(c.title); saveMedical();
                document.getElementById('clinicalFeedback').innerHTML = `<div class="case-feedback">📚 <strong>Let's correct it.</strong><br>${c.ex}<br><button onclick="nextClinicalCase()">➡️ Try the next case</button></div>`;
            }
        }
        function nextClinicalCase() { clinicalIndex = (clinicalIndex + 1) % clinicalCases.length; localStorage.setItem('medClinicalIndex', clinicalIndex); renderClinicalCase(); updateMedicalStats(); }
        const medicalCBT = [
          { q: 'Which bone is in the arm?', o: ['Humerus', 'Radius', 'Ulna', 'Scapula'], a: 0, e: 'The humerus is the long bone of the arm.' },
          { q: 'In anatomical position, the radius is on the:', o: ['Little-finger side', 'Thumb side', 'Shoulder side', 'Chest side'], a: 1, e: 'Radius = thumb side; ulna = little-finger side.' },
          { q: 'Which is a common resting adult RR teaching range?', o: ['2–5/min', '12–20/min', '30–40/min', '80–100/min'], a: 1, e: '12–20/min is a common teaching range for a resting adult.' },
          { q: 'A patient is sweaty, shaky, hungry and confused after insulin. What should you check?', o: ['Capillary blood glucose', 'Height', 'BMI', 'Only temperature'], a: 0, e: 'Possible hypoglycaemia: check glucose promptly.' },
          { q: 'ABC stands for:', o: ['Airway, Breathing, Circulation', 'Alertness, Blood, Calcium', 'Air, Brain, Cardiac', 'Assessment, Breathing, Care'], a: 0, e: 'ABC = Airway, Breathing, Circulation.' },
          { q: 'Which group contains wrist bones?', o: ['Carpals', 'Metacarpals', 'Phalanges', 'Tarsals'], a: 0, e: 'Carpals are the wrist bones.' }
        ];
        let medCBTIndex = Number(localStorage.getItem('medCBTIndex') || 0), medCBTAnswered = false;
        function renderMedicalCBT() {
            const q = medicalCBT[medCBTIndex % medicalCBT.length], el = document.getElementById('medicalCBTCard');
            if (!el) return;
            medCBTAnswered = false;
            el.innerHTML = `<div class="case-step">QUESTION ${medCBTIndex % medicalCBT.length + 1} OF ${medicalCBT.length}</div><h3>🧠 ${q.q}</h3>${q.o.map((x,i)=>`<button class="clinical-choice" onclick="answerMedicalCBT(this,${i},${q.a})">${String.fromCharCode(65+i)}. ${x}</button>`).join('')}<div id="medCBTFeedback"></div>`;
        }
        function answerMedicalCBT(btn, i, a) {
            if (medCBTAnswered) return;
            medCBTAnswered = true;
            medicalData.cbtAnswered = (medicalData.cbtAnswered || 0) + 1;
            const q = medicalCBT[medCBTIndex % medicalCBT.length];
            if (i === a) {
                btn.classList.add('correct');
                medicalData.cbtCorrect = (medicalData.cbtCorrect || 0) + 1;
                awardXP(4, 'medical_cbt');
                document.getElementById('medCBTFeedback').innerHTML = `<div class="case-feedback">🎯 Correct! ${q.e}<br><button onclick="nextMedicalCBT()">➡️ Next question</button></div>`;
            } else {
                btn.classList.add('wrong');
                medicalData.mistakes.push(q.q);
                document.getElementById('medCBTFeedback').innerHTML = `<div class="case-feedback">📚 Not quite. ${q.e}<br><button onclick="nextMedicalCBT()">➡️ Next question</button></div>`;
            }
            saveMedical(); updateMedicalStats();
        }
        function nextMedicalCBT() { medCBTIndex = (medCBTIndex + 1) % medicalCBT.length; localStorage.setItem('medCBTIndex', medCBTIndex); renderMedicalCBT(); }
        function renderMedicalProgress() {
            const el = document.getElementById('medicalProgressCard'); if (!el) return;
            const total = anatomyTopics.length + physiologyTopics.length + nursingTopics.length;
            const done = Object.keys(medicalData.topics).filter(k => medicalData.topics[k]).length;
            const weak = [...new Set(medicalData.mistakes || [])].slice(-6);
            el.innerHTML = `<h3>📈 Your Medical Academy Progress</h3><div class="med-progress"><div style="width:${Math.min(100,Math.round(done/total*100))}%"></div></div><p class="med-note" style="margin-top:6px">${done} of ${total} listed learning topics completed.</p><div style="margin-top:12px"><span class="med-chip">🦴 Anatomy: ${anatomyTopics.filter(t=>medicalData.topics['anatomy_'+t.id]).length}/${anatomyTopics.length}</span><span class="med-chip">🫀 Physiology: ${physiologyTopics.filter(t=>medicalData.topics['physiology_'+t.id]).length}/${physiologyTopics.length}</span><span class="med-chip">🩺 Nursing: ${nursingTopics.filter(t=>medicalData.topics['nursing_'+t.id]).length}/${nursingTopics.length}</span></div><div class="lesson-box" style="margin-top:10px"><strong>🧠 Mistake bank</strong><p class="med-note">${weak.length?weak.map(x=>'• '+x).join('<br>'):'No recorded mistakes yet — keep testing yourself.'}</p></div>`;
        }
        function renderMedicalAcademy() { updateMedicalStats(); }

        /* ===== V7.1 MEDICAL ACADEMY UX PATCH ===== */
        (function(){
            const oldMedTopicCard = typeof medTopicCard === 'function' ? medTopicCard : null;
            if (oldMedTopicCard) {
                medTopicCard = function(t, fn) {
                    const done = !!medicalData.topics[t.id];
                    return `<button type="button" class="med-topic ${done?'done':''}" onclick="${fn}('${t.id}')" aria-label="Open ${t.name}">
                        <div class="icon">${t.icon}</div><strong>${t.name}</strong><span>${t.sub}</span>
                        <div class="med-progress"><div style="width:${done?'100':'0'}%"></div></div>
                        <span style="color:${done?'#86efac':'#64748b'};font-size:.62rem">${done?'✓ Learned':'Tap to learn'}</span>
                    </button>`;
                };
            }

            const oldRenderMedicalAcademy = renderMedicalAcademy;
            renderMedicalAcademy = function() {
                updateMedicalStats();
                const total = anatomyTopics.length + physiologyTopics.length + nursingTopics.length;
                const done = Object.values(medicalData.topics || {}).filter(Boolean).length;
                const pct = total ? Math.round(done / total * 100) : 0;
                const mistakes = (medicalData.mistakes || []).length;
                const host = document.getElementById('sectionMedicalAcademy');
                if (host) {
                    let banner = document.getElementById('medicalContinueBanner');
                    if (!banner) {
                        const firstCard = host.querySelector('.card');
                        banner = document.createElement('div'); banner.id = 'medicalContinueBanner'; banner.className = 'card';
                        if (firstCard && firstCard.after) firstCard.after(banner); else host.appendChild(banner);
                    }
                    const next = medicalData.lastTopic;
                    let action = 'Start Anatomy';
                    let actionFn = "navigateTo('medicalAnatomy')";
                    if (next) {
                        const parts = next.split(':');
                        const kind = parts[0], id = parts[1];
                        const names = { anatomy: 'Anatomy', physiology: 'Physiology', nursing: 'Nursing Fundamentals' };
                        action = `Continue ${names[kind] || 'Medical Academy'}`;
                        actionFn = kind === 'anatomy'
                            ? `navigateTo('medicalAnatomy');setTimeout(function(){openAnatomyTopic('${id}');},50)`
                            : kind === 'physiology'
                                ? `navigateTo('medicalPhysiology');setTimeout(function(){openPhysiologyTopic('${id}');},50)`
                                : kind === 'nursing'
                                    ? `navigateTo('medicalNursing');setTimeout(function(){openNursingTopic('${id}');},50)`
                                    : `navigateTo('medicalAcademy')`;
                    }
                    banner.innerHTML = `<div class="med-study-banner"><strong>📍 Your study position:</strong> ${done}/${total} topics complete (${pct}%). ${mistakes?`You have ${mistakes} recorded mistake${mistakes===1?'':'s'} to review.`:'No mistakes recorded yet — keep testing yourself.'}</div><div class="med-action-row"><button class="success" onclick="${actionFn}">▶️ ${action}</button><button class="secondary" onclick="navigateTo('medicalClinical')">🚨 Practice a Case</button></div>`;
                }
                // FIX: variable name corrected (was oldMedRenderMedicalAcademy)
                if (typeof oldRenderMedicalAcademy === 'function') oldRenderMedicalAcademy();
            };

            function rememberTopic(kind, id) { medicalData.lastTopic = `${kind}:${id}`; saveMedical(); }
            const origAnatomy = openAnatomyTopic;
            openAnatomyTopic = function(id) { rememberTopic('anatomy', id); origAnatomy(id); };
            const origPhys = openPhysiologyTopic;
            openPhysiologyTopic = function(id) { rememberTopic('physiology', id); origPhys(id); };
            const origNursing = openNursingTopic;
            openNursingTopic = function(id) { rememberTopic('nursing', id); origNursing(id); };

            const origNavigate = navigateTo;
            navigateTo = function(section) {
                origNavigate(section);
                window.scrollTo({ top: 0, behavior: 'smooth' });
                if (section === 'medicalAcademy') renderMedicalAcademy();
                if (section === 'medicalProgress') renderMedicalProgress();
            };

            /* Re-render medical screens after a lesson is completed so progress is visible immediately. */
            const origComplete = completeMedicalTopic;
            completeMedicalTopic = function(kind, id) {
                rememberTopic(kind, id);
                origComplete(kind, id);
                if (typeof renderMedicalProgress === 'function') renderMedicalProgress();
                if (typeof renderMedicalAcademy === 'function') renderMedicalAcademy();
            };
        })();

        // ─── INIT ───
        function init() {
            const savedTheme = localStorage.getItem('goatTheme') || '';
            if (savedTheme) {
                document.body.className = savedTheme;
                const idx = themes.indexOf(savedTheme);
                if (idx >= 0) themeIndex = idx;
            }
            document.getElementById('pomodoroCount').innerText = pomodoroCompleted;
            timerRemaining = timerSeconds;
            updateTimerDisplay();
            if (localStorage.getItem('gpaSemesterTitle')) {
                document.getElementById('gpaSemesterTitle').textContent = localStorage.getItem('gpaSemesterTitle');
            }
            refreshAll();
            console.log('🐐 GoatTutor NG – Updated with Course Selector & 300+ Questions');
        }

        document.addEventListener('DOMContentLoaded', init);
        document.getElementById('sidebarOverlay').addEventListener('click', closeMenu);
        document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeMenu(); });

        // ─── EXPOSE ───
        window.navigateTo = navigateTo;
        window.toggleMenu = toggleMenu;
        window.closeMenu = closeMenu;
        window.toggleGroup = toggleGroup;
        window.toggleAuthMode = toggleAuthMode;
        window.handleAuth = handleAuth;
        window.handleLogout = handleLogout;
        window.cycleTheme = cycleTheme;
        window.addGpaRow = addGpaRow;
        window.removeGpaRow = removeGpaRow;
        window.calculateGPA = calculateGPA;
        window.saveGpaSemester = saveGpaSemester;
        window.clearGpaSemester = clearGpaSemester;
        window.addScreeningSubject = addScreeningSubject;
        window.removeScreeningSubject = removeScreeningSubject;
        window.calculateScreening = calculateScreening;
        window.filterCutoff = filterCutoff;
        window.selectQuizOption = selectQuizOption;
        window.nextQuizQuestion = nextQuizQuestion;
        window.resetQuiz = resetQuiz;
        window.startDailyQuiz = startDailyQuiz;
        window.startTimer = startTimer;
        window.pauseTimer = pauseTimer;
        window.resetTimer = resetTimer;
        window.setTimerPreset = setTimerPreset;
        window.applyCustomTimer = applyCustomTimer;
        window.addPlannerTask = addPlannerTask;
        window.togglePlannerTask = togglePlannerTask;
        window.removePlannerTask = removePlannerTask;
        window.renderSessionLog = renderSessionLog;
        window.clearSessionLog = clearSessionLog;
        window.exportSessionLog = exportSessionLog;
        window.loadLeaderboard = loadLeaderboard;
        window.forceSyncGamification = forceSyncGamification;
        window.runAnalysis = runAnalysis;
        window.submitUpdate = submitUpdate;
        window.logStudyDay = logStudyDay;
        window.resetStreakStats = resetStreakStats;
        window.recalculateCGPA = recalculateCGPA;
        window.shareCGPACard = shareCGPACard;
        window.openAI = openAI;
        window.askGoatTutor = askGoatTutor;
        window.openAIFallback = openAIFallback;
        window.showNotification = showNotification;
        window.fireConfetti = fireConfetti;
        window.handlePDFFile = handlePDFFile;
        window.copyPDFText = copyPDFText;
        window.openPDFWithAI = openPDFWithAI;
        window.askPDFWithAI = askPDFWithAI;
        window.setTargetPreset = setTargetPreset;
        window.applyCustomTarget = applyCustomTarget;
        window.addTargetCourse = addTargetCourse;
        window.calculateTarget = calculateTarget;
        window.renderTargetCalculator = renderTargetCalculator;
        window.renderMedicalAcademy = renderMedicalAcademy;
        window.renderAnatomyTopics = renderAnatomyTopics;
        window.renderPhysiologyTopics = renderPhysiologyTopics;
        window.renderNursingTopics = renderNursingTopics;
        window.openAnatomyTopic = openAnatomyTopic;
        window.openPhysiologyTopic = openPhysiologyTopic;
        window.openNursingTopic = openNursingTopic;
        window.completeMedicalTopic = completeMedicalTopic;
        window.checkMiniCBT = checkMiniCBT;
        window.renderClinicalCase = renderClinicalCase;
        window.answerClinicalCase = answerClinicalCase;
        window.nextClinicalCase = nextClinicalCase;
        window.renderMedicalCBT = renderMedicalCBT;
        window.answerMedicalCBT = answerMedicalCBT;
        window.nextMedicalCBT = nextMedicalCBT;
        window.renderMedicalProgress = renderMedicalProgress;
    </script>
</body>
</html>
